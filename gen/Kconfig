mainmenu "TAPAS Flight Software Configuration"

menu "General setup"

config CONFIG_NAME
    string "Configuration Name"
    default "default"
    help
        The name of the configuration that will be used when saving or loading configs.

config PROJ_NAME
    string "Project Name"
    default "flight-software"
    help
        Enter the project name for the flight software.

choice
    prompt "Target Board"
    default BOARD_ART_PI
    help
        Select the target board for the build.

config BOARD_ART_PI
    bool "ART PI"
config BOARD_KLARA
    bool "KLARA"
config BOARD_QEMU
    bool "QEMU"
config BOARD_NUCLEO_H745ZI
    bool "Nucleo H745ZI"
config BOARD_NUCLEO_F411RE
    bool "Nucleo F411RE"

endchoice

if BOARD_ART_PI
source "kernel/bsp/ART_PI-BSP/Kconfig"
endif

if BOARD_KLARA
source "kernel/bsp/KLARA-BSP/Kconfig"
endif

if BOARD_QEMU
source "kernel/bsp/QEMU-BSP/Kconfig"
endif

if BOARD_NUCLEO_H745ZI
source "kernel/bsp/NUCLEO_H745ZI-BSP/Kconfig"
endif

if BOARD_NUCLEO_F411RE
source "kernel/bsp/NUCLEO_F411RE-BSP/Kconfig"
endif

config IS_A_TEST
    bool "Enable Test Mode"
    help
        Enable this option to configure and select a specific test to run.

if IS_A_TEST
choice
    prompt "Select the Target Test"
    help
        Choose a specific test to run if Test Mode is enabled.

config TEST_HELLO
    bool "Hello Test"

config TEST_FDIR
    bool "FDIR Test"

config TEST_IRIDIUM
    bool "Iridium Test"

config TEST_OW
    bool "OneWire Test"

config TEST_I2C
    bool "I2C Test"

config TEST_TIMERS
    bool "Timers Test"

config TEST_USAGE
    bool "Usage Test"

endchoice

config TEST_NAME
    string
    help
        Automatically sets the test name based on the selected test.
    depends on IS_A_TEST
    default "test-hello" if TEST_HELLO
    default "test-fdir" if TEST_FDIR
    default "test-iridium" if TEST_IRIDIUM
    default "test-ow" if TEST_OW
    default "test-i2c" if TEST_I2C
    default "test-timers" if TEST_TIMERS
    default "test-usage" if TEST_USAGE
    default ""

endif

endmenu # General setup

menu "Build Configuration"

choice
    prompt "Optimization level"
    default OPT_O0
    help
      Select the compiler optimization level.

config OPT_O0
    bool "No optimization (-O0)"

config OPT_O1
    bool "Optimize (-O1)"

config OPT_O2
    bool "Optimize more (-O2)"

config OPT_O3
    bool "Optimize even more (-O3)"

config OPT_OS
    bool "Optimize for size (-Os)"

endchoice

choice
    prompt "Debug information level"
    default DEBUG_G3
    help
      Select the amount of debugging information generated by the compiler.

config DEBUG_G0
    bool "No debug info (-g0)"

config DEBUG_G1
    bool "Minimal debug info (-g1)"

config DEBUG_G2
    bool "Default debug info (-g2)"

config DEBUG_G3
    bool "Maximum debug info (-g3)"

endchoice

endmenu # Build Configuration

menu "Kernel Configuration"

config KERNEL_DEFCONFIG
    string "Kernel Configuration"
    default "default_defconfig"
    help
      Choose a kernel configuration.

endmenu # Kernel Configuration
