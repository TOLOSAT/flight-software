    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ART-PI Bootloader",
            "cwd": "${workspaceRoot}",
            "executable": "./build/target/boot-software-debug.elf",
            "preLaunchTask": "Build Program",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "gdb-multiarch",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "svdFile": "../tools/BSPs/ART-PI-BSP/debug/STM32H750.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug NUCLEO-H745ZI Bootloader",
