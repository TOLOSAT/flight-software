            "executable": "./build/target/boot-software-debug.elf",
            "preLaunchTask": "Build Program",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "gdb-multiarch",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "svdFile": "../tools/BSPs/NUCLEO-H745ZI-BSP/debug/STM32H745_CM7.svd",
