/* Put section macro */
#ifndef PUT_SECTION
#define PUT_SECTION(section)    . = ALIGN(4); \
                                _##section##_start_ = .; \
                                *(.section) \
                                . = ALIGN(4); \
                                _##section##_end_ = .;
#endif

/* FS contained sections */
#define FS_TEXT_SEGMENT         . = ALIGN(4); \
                                _text_fs_start_ = .; \
                                *(.text_fs) \
                                *libfatfs*.a:*(.text .text.*) \
                                . = ALIGN(4); \
                                _text_fs_end_ = .;

#define FS_DATA_SEGMENT         . = ALIGN(4); \
                                _data_fs_start_ = .; \
                                *(.data_fs) \
                                *libfatfs*.a:*(.data .data.* .bss .bss.*) \
                                . = ALIGN(4); \
                                _data_fs_end_ = .;
