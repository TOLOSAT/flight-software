/* Put section macro */
#ifndef PUT_SECTION
#define PUT_SECTION(section)    . = ALIGN(4); \
                                _##section##_start_ = .; \
                                *(.section) \
                                . = ALIGN(4); \
                                _##section##_end_ = .;
#endif

/* FS contained sections */
#define FS_TEXT_SEGMENT        PUT_SECTION(text_fs)
#define FS_DATA_SEGMENT        PUT_SECTION(data_fs)