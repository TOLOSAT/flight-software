#include "application.ldf"
#include "kernel.ldf"
#include "pus-library.ldf"
#include "iridium_driver.ldf"
#include "bsp.ldf"

/* Entry Point */
ENTRY(Reset_Handler)

/* Memories definition */
MEMORY
{
    ITCM_RAM    (rwx) : ORIGIN = 0x00000000, LENGTH = 64K
    DTCM_RAM    (rw)  : ORIGIN = 0x20000000, LENGTH = 128K
    PSRAM       (rw)  : ORIGIN = 0x60000000, LENGTH = 2M
    EXTRA_RAM   (rw)  : ORIGIN = 0x60200000, LENGTH = 14M
}

/* Stack & Heap definitions */
__stack_end__ = ORIGIN(DTCM_RAM) + LENGTH(DTCM_RAM);
__Min_Heap_Size__ = 0x200;
__Min_Stack_Size__ = 0x400;

/* Variable used to know where the limit between code and data in AXI SRAM */
__PSRAM_section_separation__            = ORIGIN(PSRAM) + LENGTH(PSRAM)/2;

/* Variables used by FreeRTOS-MPU. */
__privileged_functions_region_size__    = 64K;
__privileged_data_region_size__         = 8K;

__FLASH_segment_start__                 = ORIGIN(PSRAM);
__FLASH_segment_end__                   = __PSRAM_section_separation__;

__SRAM_segment_start__                  = __PSRAM_section_separation__;
__SRAM_segment_end__                    = ORIGIN(PSRAM) + LENGTH(PSRAM);

/* Sections */
SECTIONS
{
    /* The preferred codes go into the .itcm_text section, which is faster. */
    .itcm_text :
    {
        . = ALIGN(4);
        __itcm_start__ = .;
        __privileged_functions_start__ = .;
        KEEP(*(.isr_vector))
        . = ALIGN(4);
        *(privileged_functions)
        . = ALIGN(4);
        FILL(0xDEAD);
        . = __privileged_functions_start__ + __privileged_functions_region_size__;
        __privileged_functions_end__ = .;
        __itcm_end__ = .;
    } >ITCM_RAM

    /* The preferred data go into the .dtcm_data section, which is faster. */
    .dtcm_data :
    {
        . = ALIGN(4);
        __dtcm_start__ = .;
        __privileged_data_start__ = .;
        *(privileged_data)
        . = ALIGN(4);
        FILL(0xDEAD);
        . = __privileged_data_start__ + __privileged_data_region_size__;
        __privileged_data_end__ = .;
        . = ALIGN(4);
        *(.desc_tables)
        *(.task_tcbs)
        *(.task_stacks)
        *(.buffer_entities)
        *(.buffer_arrays)
        *(.mutex_queues)
        __dtcm_end__ = .;
    } >DTCM_RAM

    /* Use of the rest of DTCM RAM for the main stack */
    .main_stack :
    {
        . = ALIGN(8);
        . = . + __Min_Stack_Size__;
        . = ALIGN(8);
    } >DTCM_RAM

    /* The program goes into the .text section */
    .text :
    {
        . = ALIGN(4);
        __text_start__ = .;
        __syscalls_flash_start__ = .;
        *(freertos_system_calls)
        __syscalls_flash_end__ = .;
        . = ALIGN(4);
        APP_TEXT_SEGMENT
        CORE_TEXT_SEGMENT
        PUS_TEXT_SEGMENT
        IRIDIUM_DRV_TEXT_SEGMENT
        HAL_TEXT_SEGMENT
        BSP_TEXT_SEGMENT
        *(.text)
        *(.text*)
        . = ALIGN(4);
        __text_end__ = .;
    } >PSRAM

    /* Constant data goes into .rodata section */
    .rodata :
    {
        . = ALIGN(4);
        __rodata_start__ = .;
        *(.rodata)
        *(.rodata*)
        *(.conf_tables)
        . = ALIGN(4);
        __rodata_end__ = .;
    } >PSRAM

    /* Initialized data go into the .data section */
    .data __PSRAM_section_separation__ :
    {
        . = ALIGN(4);
        __data_start__ = .;
        APP_DATA_SEGMENT
        CORE_DATA_SEGMENT
        PUS_DATA_SEGMENT
        IRIDIUM_DRV_DATA_SEGMENT
        HAL_DATA_SEGMENT
        BSP_DATA_SEGMENT
        *(.data)
        *(.data*)
        . = ALIGN(4);
        __data_end__ = .;
    } >PSRAM

    /* Uninitialised data goes into .bss section */
    .bss :
    {
        __bss_start__ = .;
        *(.bss)
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
    } >PSRAM

    /* The temporary files of the file system goes into .tmpfs to avoid saturating the AXI SRAM. */
    .tmpfs :
    {
        . = ALIGN(4);
        __tmpfs_start__ = .;
        *(.tmpfs)
        . = ALIGN(4);
        __tmpfs_end__ = .;
    } >PSRAM

    /* The dma buffers goes into .dmabuff to avoid saturating the AXI SRAM. */
    .dmabuff :
    {
        . = ALIGN(4);
        __dmabuff_start__ = .;
        *(.dmabuff)
        . = ALIGN(4);
        __dmabuff_end__ = .;
    } >PSRAM

    /* Use of the rest of PSRAM for the heap (should remain empty) */
    .heap :
    {
        . = ALIGN(8);
        PROVIDE ( end = . );
        PROVIDE ( _end = . );
        . = . + __Min_Heap_Size__;
        . = ALIGN(8);
    } >PSRAM

    /* EXTRA RAM zone used for RAM file system */
    .ramfs :
    {
        . = ALIGN(4);
        __ramfs_start__ = .;
        FILL(0);
        . += LENGTH(EXTRA_RAM);
        __ramfs_end__ = .;
        . = ALIGN(4);
    } >EXTRA_RAM
}
