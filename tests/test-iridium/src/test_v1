uint64_t timestamp_def()
{
    time_t now;
    now=time(NULL);
    uint64_t timestamp=(uint64_t)now;
    return timestamp;
}
struct hk_header_t{
    uint64_t timestamp_send;   // heure d’envois
    uint16_t N;  //nombre de données envoyer
} ;

void collect_header(struct hk_header_t *header)
{
    header->timestamp_send=timestamp_def();
    header->N=1;
}


struct hk_paquet_t{
    uint64_t timestamp_data; // timestamp de la data
    uint16_t lentgh_data; // taille de la donnée
    float temperature_value; // valeur de la data
};

void collect_hk(struct hk_paquet_t *paquet)
{
    paquet->timestamp_data=timestamp_def();
    paquet->temperature_value=25;
    paquet->lentgh_data=sizeof(paquet->temperature_value);
};

