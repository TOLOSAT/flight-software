{
    "system": {
        "tasks": [
            {
                "ref": "ONESHOT_TASK",
                "name": "ONESHOT",
                "function": "OneshotMain",
                "priority": "PRIORITY_LOW",
                "stack_size": 2048,
                "period": 1000,
                "privilege": "TASK_UNPRIVILEGED"
            },
            {
                "ref": "PAUSERESUME_TASK",
                "name": "PAUSE_RESUME",
                "function": "PauseResumeMain",
                "priority": "PRIORITY_LOW",
                "stack_size": 2048,
                "period": 1000,
                "privilege": "TASK_UNPRIVILEGED"
            }
        ],
        "buffers": [
            {
                "ref": "DUMMY_BUFF",
                "sender_ref": "ONESHOT_TASK",
                "receiver_ref": "ONESHOT_TASK",
                "width": 4,
                "depth": 3
            }
        ],
        "mutexes": [
            {
                "ref": "DUMMY_MUTEX"
            }
        ],
        "files": [
            {
                "ref": "TEST_FILE",
                "path": "tests/test.txt",
                "access_mode": "FILE_MODE_CREATE | FILE_MODE_READ | FILE_MODE_WRITE | FILE_MODE_SYNC"
            },
            {
                "ref": "CONSOLE_FILE",
                "path": "logs/console.log",
                "access_mode": "FILE_MODE_CREATE | FILE_MODE_READ"
            },
            {
                "ref": "CONSOLE_OLD_FILE",
                "path": "logs/old_console.log",
                "access_mode": "FILE_MODE_CREATE | FILE_MODE_READ"
            }
        ],
        "timers": [
            {
                "ref": "ONESHOT_TIMER",
                "owner": "ONESHOT_TASK"
            },
            {
                "ref": "PAUSERESUME_TIMER",
                "owner": "PAUSERESUME_TASK"
            }
        ]
    }
}