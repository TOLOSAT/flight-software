{
    "system": {
        "tasks": [
            {
                "ref": "MAIN_TASK",
                "name": "MAIN_TASK",
                "function": "DummyMainTask",
                "priority": "PRIORITY_LOW",
                "stack_size": 2048,
                "period": 200,
                "privilege": "TASK_UNPRIVILEGED"
            }
        ],
        "buffers": [
            {
                "ref": "DUMMY_BUFF",
                "sender_ref": "MAIN_TASK",
                "receiver_ref": "MAIN_TASK",
                "width": 4,
                "depth": 3
            }
        ],
        "mutexes": [
            {
                "ref": "DUMMY_MUTEX"
            }
        ],
        "files": [
            {
                "ref": "TEST_FILE",
                "path": "tests/test.txt",
                "access": "FA_OPEN_ALWAYS | FA_WRITE | FA_READ",
                "synchronisation": "FS_AUTO_SYNC_ENABLE"
            },
            {
                "ref": "CONSOLE_FILE",
                "path": "logs/console.log",
                "access": "FA_OPEN_ALWAYS | FA_WRITE | FA_READ",
