/* Put section macro */
#ifndef PUT_SECTION
#define PUT_SECTION(section)    . = ALIGN(4); \
                                _##section##_start_ = .; \
                                *(.section) \
                                . = ALIGN(4); \
                                _##section##_end_ = .;
#endif

/* PUS contained sections */
#define BSP_TEXT_SEGMENT        PUT_SECTION(text_bsp)
#define BSP_DATA_SEGMENT        PUT_SECTION(data_bsp)