{
    // Utilisez IntelliSense pour en savoir plus sur les attributs possibles.
    // Pointez pour afficher la description des attributs existants.
    // Pour plus d'informations, visitez : https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H7",
            "cwd": "${workspaceRoot}",
            "executable": "./build/output/flight-software-debug.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "overrideLaunchCommands" : [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/output/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "overrideResetCommands": [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/output/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "overrideRestartCommands": [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/output/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "svdFile": "tools/svd/debug/STM32H750.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach STM32H7",
            "cwd": "${workspaceRoot}",
            "executable": "./build/output/flight-software-debug.elf",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "preAttachCommands" : [
                "monitor gdb_breakpoint_override hard",
            ],
            "svdFile": "tools/svd/debug/STM32H750.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug QEMU",
            "cwd": "${workspaceRoot}",
            "executable": "./build/output/flight-software-debug.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "qemu",
            "runToEntryPoint": "main",
            "cpu": "cortex-m7",
            "machine": "mps2-an500",
            "svdFile": "tools/svd/debug/CMSDK_CM7.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug STM32F4",
            "cwd": "${workspaceRoot}",
            "executable": "./build/output/flight-software-debug.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "svdFile": "tools/svd/debug/STM32F411.svd",
            "showDevDebugOutput": "none"
        },
    ]
}