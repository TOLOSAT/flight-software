    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ART-PI",
            "cwd": "${workspaceRoot}",
            "executable": "./build/output/flight-software-debug.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "overrideLaunchCommands" : [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/output/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "overrideResetCommands": [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/output/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "overrideRestartCommands": [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/output/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "svdFile": "bsp/ART_PI-BSP/debug/STM32H750.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach ART-PI",
            "cwd": "${workspaceRoot}",
            "executable": "./build/output/flight-software-debug.elf",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "preAttachCommands" : [
                "monitor gdb_breakpoint_override hard",
            ],
            "svdFile": "bsp/ART_PI-BSP/debug/STM32H750.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug QEMU",
            "cwd": "${workspaceRoot}",
