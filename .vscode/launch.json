{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H7",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/output/flight-software.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "overrideLaunchCommands" : [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ${workspaceFolder}/build/output/flight-software.elf",
                "monitor halt"
            ],
            "overrideResetCommands": [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ${workspaceFolder}/build/output/flight-software.elf",
                "monitor halt"
            ],
            "overrideRestartCommands": [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ${workspaceFolder}/build/output/flight-software.elf",
                "monitor halt"
            ],
            "svdFile": "tools/svd/debug/STM32H750.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach STM32H7",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/output/flight-software.elf",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "preAttachCommands" : [
                "monitor gdb_breakpoint_override hard",
            ],
            "svdFile": "tools/svd/debug/STM32H750.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug QEMU",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/output/flight-software.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "qemu",
            "runToEntryPoint": "main",
            "cpu": "cortex-m7",
            "machine": "mps2-an500",
            "svdFile": "tools/svd/debug/CMSDK_CM7.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach QEMU",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/output/flight-software.elf",
            "request": "attach",
            "type": "cortex-debug",
            "gdbPath": "gdb-multiarch",
            "servertype": "external",
            "gdbTarget": ":1234",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug STM32F4",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/output/flight-software.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "svdFile": "tools/svd/debug/STM32F411.svd",
            "showDevDebugOutput": "none"
        },
    ]
}