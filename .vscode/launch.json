    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H7 RAM",
            "cwd": "${workspaceRoot}",
            "executable": "./build/target/flight-software-debug.elf",
            "preLaunchTask": "Build Program",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "gdb-multiarch",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "overrideLaunchCommands" : [
                "monitor reset init",
                "monitor gdb_breakpoint_override hard",
                "monitor load_image ./build/target/flight-software-debug.elf",
                "monitor reset halt"
            ],
            "searchDir": [],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
